def mySqrt(x: int) -> int:
    # Base cases for 0 and 1
    if x < 2:
        return x
    
    left, right = 2, x // 2
    ans = 0
    
    while left <= right:
        mid = left + (right - left) // 2
        num = mid * mid
        
        if num == x:
            return mid
        elif num < x:
            ans = mid      # Keep track of the closest smaller value
            left = mid + 1
        else:
            right = mid - 1
            
    return ans
